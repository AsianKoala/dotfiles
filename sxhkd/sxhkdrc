#
# wm independent hotkeys
#

# terminal emulator
super + Return
	kitty

# program launcher
super + @space
  rofi -modi drun,run -show drun -no-history -matching prefix -drun-match-fields name -no-tokenize 

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

super + shift + r
  bspc wm -r

# close and kill
super + {_,shift + }w
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next


#
# state/flags
#

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags

#
# focus/swap
#


super + {h,j,k,l}
  dir={west,south,north,east}; \
  bspc node "$dir.local" -f \
    || bspc monitor "$dir" -f

super + shift + {h,j,k,l}
    dir={west,south,north,east}; \
    bspc node -s "$dir.local" --follow \
        || bspc node -m "$dir" --follow


# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + Tab
	bspc desktop -f last

super + grave 
  betterlockscreen -l


#focus or send to the Nth desktop *of the currently focused monitor*
# (super+1..5 = local desktops on this monitor; super+shift+1..5 = send window there)

super + {1,2,3,4,5}
  bspc desktop -f "$(bspc query -D -m focused --names | sed -n '{1,2,3,4,5}p')"

super + shift + {1,2,3,4,5}
  bspc node -d "$(bspc query -D -m focused --names | sed -n '{1,2,3,4,5}p')" --follow

super + shift + bracket{left,right}
  bspc node -d {prev,next}.local

super + z
	bspc desktop -f prev.local
  
super + x
	bspc desktop -f next.local


{% if "laptop" in profiles %}

# zen mode: zero gaps/padding + kill polybar (picom fades it out/in)
super + backslash
  ~/scripts/zen.sh

# toggle polybar visibility; on show, force-raise above kitty (else fullscreen
# kitty stays on top because bspwm wins polybar's wm-restack race)
super + minus
  sh -c '(polybar-msg cmd toggle 2>/dev/null || ~/.config/polybar/launch.sh); sleep 0.1; ~/scripts/polybar-raise.sh'

super + Delete
  betterlockscreen -l dim --display 1

XF86AudioRaiseVolume
  pactl set-sink-volume 0 +2%
XF86AudioLowerVolume
  pactl set-sink-volume 0 -2%
XF86AudioMute
  pactl set-sink-mute 0 toggle
XF86AudioPrev
  $HOME/scripts/sp prev
XF86AudioNext
  $HOME/scripts/sp next
XF86AudioPlay
  $HOME/scripts/sp play

XF86MonBrightnessUp
  brightnessctl set +2%

XF86MonBrightnessDown
  brightnessctl set 2%-

{% else %}
super + Scroll_Lock
  betterlockscreen -l dim --display 1

super + Delete
  mpc volume -1

super + End 
  mpc toggle

super + Next 
  mpc volume +1

# super + Insert 
#   mpc next 
#
# super + Prior 
#   mpc prev 

super + Home
  mpc single

XF86AudioPlay
  mpc toggle

XF86AudioPrev
  mpc next

XF86AudioNext
  mpc prev

XF86AudioRewind
  mpc single

XF86AudioRaiseVolume
  mpc volume +1

XF86AudioLowerVolume
  mpc volume -1

{% endif %}

super + shift + s
  flameshot gui

super + b
  {{ browser.cmd }}

super + c 
  clipster -sc

super + period
  rofi -modi emoji -show emoji -kb-custom-1 Ctrl+C

# bluetooth manager
super + shift + b
  ~/scripts/rofi-bluetooth.sh


super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

super + ctrl + space
	bspc node -p cancel

super + e
  pcmanfm 

# relink dotfiles for whatever profile set is currently active
super + g
  bombadil link -p {{ profiles | join(sep=" ") }}

