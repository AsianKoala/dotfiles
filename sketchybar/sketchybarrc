#!/usr/bin/env bash
# ============================================================================
# sketchybar — yabai workspace indicators (per-space app icons) + status
# cluster, themed from the pywal palette. Fonts: JetBrainsMono Nerd Font.
# ============================================================================

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"     # BAR_COLOR ICON_COLOR LABEL_COLOR ACCENT_COLOR SPACE_BG ITEM_BG DIM_COLOR
source "$CONFIG_DIR/icon_map.sh"

FONT="JetBrainsMono Nerd Font"

##### Bar #####
sketchybar --bar \
  height=37 \
  position=top \
  blur_radius=30 \
  color=$BAR_COLOR \
  padding_left=10 \
  padding_right=10 \
  notch_width=200

##### Defaults #####
sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Bold:16.0" \
  label.font="$FONT:Semibold:13.0" \
  icon.color=$ICON_COLOR \
  label.color=$LABEL_COLOR \
  icon.padding_left=6 \
  icon.padding_right=6 \
  label.padding_left=3 \
  label.padding_right=6 \
  background.corner_radius=7 \
  background.height=26

##### Custom event: per-space window icons #####
sketchybar --add event windows_on_spaces

##### Spaces (yabai / mission control) #####
for sid in 1 2 3 4 5; do
  sketchybar --add space space.$sid left \
    --set space.$sid \
      space=$sid \
      icon=$sid \
      icon.font="$FONT:Bold:14.0" \
      icon.highlight_color=$ACCENT_COLOR \
      label.font="$FONT:Regular:15.0" \
      label.color=$DIM_COLOR \
      label.highlight_color=$ICON_COLOR \
      label.drawing=off \
      label.padding_left=2 \
      background.color=$SPACE_BG \
      background.drawing=off \
      script="$PLUGIN_DIR/space.sh" \
      click_script="yabai -m space --focus $sid" \
    --subscribe space.$sid mouse.clicked
done

# hidden driver: refresh all space app-icon labels on relevant events
sketchybar --add item space_windows left \
  --set space_windows drawing=off script="$PLUGIN_DIR/space_windows.sh" \
  --subscribe space_windows windows_on_spaces front_app_switched space_change

##### Left: focused app name #####
sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.font="$FONT:Heavy:13.0" \
    label.color=$ACCENT_COLOR \
    padding_left=14 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Right: status cluster #####
sketchybar --add item clock right \
  --set clock update_freq=10 icon= icon.color=$ACCENT_COLOR script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item wifi right \
  --set wifi update_freq=30 icon.color=$ACCENT_COLOR script="$PLUGIN_DIR/wifi.sh"

# rounded background behind the whole right cluster
sketchybar --add bracket status wifi volume battery clock \
  --set status background.color=$ITEM_BG background.corner_radius=9 background.height=28

##### Finalize #####
sketchybar --update
sketchybar --trigger windows_on_spaces
