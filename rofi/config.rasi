configuration {
  display-drun: "";
  display-window: "";
  drun-display-format: "{icon} {name}";
  font: "JetBrainsMono Nerd Font 11";
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
}

@import "{{ wal }}/colors-rofi-dark"

* {
  bg:          @background;
  fg:          @foreground;
  accent:      @selected-normal-background;
  accent-dim:  @urgent-background;

  background-color: transparent;
  text-color:       @fg;

  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 520px;
  border-radius: 14px;
  border: 1;
  border-color: @accent-dim;
  background-color: @bg;
  padding: 14px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  children: [prompt, entry];
  padding: 6px 10px;
  background-color: transparent;
  spacing: 8px;
}

prompt {
  text-color: @accent;
  padding: 6px 0;
  font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
  padding: 6px 0;
  text-color: @fg;
  placeholder: "search";
  placeholder-color: @accent-dim;
}

listview {
  padding: 10px 0 0 0;
  columns: 1;
  lines: 8;
  fixed-height: false;
  background-color: transparent;
  spacing: 2px;
}

element {
  padding: 8px 10px;
  border-radius: 8px;
  background-color: transparent;
}

element selected {
  background-color: @accent;
  text-color: @fg;
}

element-icon {
  size: 22;
  background-color: transparent;
  padding: 0 8px 0 0;
}

element-text {
  vertical-align: 0.5;
  background-color: transparent;
  text-color: inherit;
}

/* vim: ft=sass */
